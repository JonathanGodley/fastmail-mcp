# Files excluded from the packaged .dxt extension. The runtime entry point is
# dist/index.js; source and tests (and their fixtures) must NOT ship.
#
# IMPORTANT: directory patterns are ROOT-ANCHORED (leading slash). An unanchored
# "src/" matches at any depth and once stripped node_modules/debug/src/ — the
# entry point of a runtime dependency — producing a .dxt that crashed on boot.
# Anchor anything that should only match the repository root.

# Source & tests (compiled output lives in dist/)
/src/
*.test.ts
*.test.js
*.test.mjs

# Local/live test scripts (also gitignored)
/test-live*
/.secret-scan-local.txt

# Previously packed extensions, which the next pack would nest inside the new
# archive. Unanchored on purpose: a file glob carries no directory-pattern hazard.
*.dxt

# Tooling / CI / repo scaffolding — not needed at runtime
/scripts/
/.git/
/.github/
/.githooks/
/.gitignore
/.dxtignore
/.mcp.json
/tsconfig.json
/tsconfig.tests.json
/coverage/
.env
.env.*

# Build and tool droppings. All gitignored, so none are present in a clean
# checkout — but the .dxt is packed from a working tree, and a local build or a
# stray run leaves these behind where they would be packed silently.
*.tsbuildinfo
*.log
/bun.lock
.DS_Store

# Local agent/config state that may hold credentials. Unanchored so a copy
# outside /.claude/ is caught too.
settings.local.json

# package-lock.json deliberately still ships: some packers and registry
# validators read it, and it costs a few KB.

# Dev docs / meta
/CLAUDE.md
/CONTRIBUTING.md
/docs/
/.claude/
/.secret-scan-local.txt.example
