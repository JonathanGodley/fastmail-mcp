# Files excluded from the packaged .dxt extension.
# The runtime entry point is dist/index.js, so source and tests must NOT ship —
# this is what prevents a test fixture (or any source-only data) from ever being
# published inside a release binary.
#
# IMPORTANT: directory patterns are ROOT-ANCHORED (leading slash). An unanchored
# "src/" matches at any depth and once stripped node_modules/debug/src/ — the
# entry point of a runtime dependency — producing a .dxt that crashed on boot.
# Anchor anything that should only match the repository root.

# Source & tests (compiled output lives in dist/)
/src/
*.test.ts
*.test.js
*.test.mjs

# Local/live test scripts (also gitignored)
/test-live*
/.secret-scan-local.txt

# Previously packed extensions. Packing into the repository root leaves a .dxt
# behind, and the next pack would otherwise nest it inside the new archive —
# doubling the size for a copy nothing reads. Left unanchored on purpose: this
# matches files, not directories, so it cannot strip a dependency's entry point
# the way an unanchored directory pattern can.
*.dxt

# Tooling / CI / repo scaffolding — not needed at runtime
/scripts/
/.git/
/.github/
/.githooks/
/.gitignore
/.dxtignore
/.mcp.json
/tsconfig.json
/tsconfig.tests.json
/coverage/
.env
.env.*

# Build and tool droppings. All gitignored, so none are present in a clean
# checkout — but the .dxt is packed from a working tree, and a local build or a
# stray run leaves these behind where they would be packed silently.
*.tsbuildinfo
*.log
/bun.lock
.DS_Store

# Local agent/config state, which .gitignore flags as possibly holding
# credentials. /.claude/ below covers the usual location; this stays unanchored
# so a copy anywhere else in the tree is caught too (a file glob, so it carries
# none of the directory-pattern hazard described at the top).
settings.local.json

# package-lock.json deliberately still ships: it is not needed at runtime, but
# some packers and registry validators read it, and the cost of shipping it is
# a few KB against a failure mode that is not obvious from inside the archive.

# Dev docs / meta
/CLAUDE.md
/CONTRIBUTING.md
/docs/
/.claude/
/.secret-scan-local.txt.example
