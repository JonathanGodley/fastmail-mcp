#!/usr/bin/env bash
# Commit-msg hook: block secrets and personal information in the commit message
# itself. The pre-commit hook covers the content; this covers the text that
# `git log`, GitHub and every release note will show.
# Enable once per clone with:  git config core.hooksPath .githooks
set -euo pipefail

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
SCANNER="$HOOK_DIR/../scripts/scan-secrets.mjs"

if ! command -v node >/dev/null 2>&1; then
  echo "commit-msg: node not found, so the secret scan cannot run." >&2
  echo "  Install node (this project needs it to build and test anyway), or" >&2
  echo "  bypass this commit deliberately with: git commit --no-verify" >&2
  exit 1
fi

node "$SCANNER" --message "$1"
