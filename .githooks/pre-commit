#!/usr/bin/env bash
# Pre-commit hook: block secrets and personal information from being committed.
# Enable once per clone with:  git config core.hooksPath .githooks
set -euo pipefail

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node not found, so the secret scan cannot run." >&2
  echo "  Install node (this project needs it to build and test anyway), or" >&2
  echo "  bypass this commit deliberately with: git commit --no-verify" >&2
  exit 1
fi

node scripts/scan-secrets.mjs --staged
