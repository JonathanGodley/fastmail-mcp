{
  "name": "fastmail-mcp",
  "version": "1.13.4-fork.3",
  "description": "Unofficial MCP server for Fastmail API integration (not affiliated with or endorsed by Fastmail)",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "fastmail-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepare": "npm run build",
    "pretest": "npm run build",
    "test": "tsx --test src/*.test.ts",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "mutate": "node scripts/mutate-commit.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs --all"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "fastmail",
    "email",
    "jmap"
  ],
  "author": "Jeremy Gill",
  "contributors": [
    "Jonathan Godley"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "debug": "4.4.3",
    "html-to-text": "^10.0.1",
    "sanitize-html": "^2.17.7",
    "tsdav": "^2.3.1"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@types/debug": "^4.1.12",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^20.19.43",
    "@types/sanitize-html": "^2.16.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
