{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["src/**/*"],
  // src/testing/ holds test-only support code. It is excluded here for the same
  // reason the .test.ts files are: it is not part of the shipped server and must
  // not land in dist/. tsconfig.tests.json declares its own exclude list, so both
  // are still typechecked by `npm run typecheck:tests`.
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/testing/**"]
}